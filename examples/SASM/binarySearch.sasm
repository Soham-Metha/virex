%include "calls.smh"

%bind     msg0      "Binary Searching for 5\n\n   Used array : \n"
%bind     msg1      "Found at : \n"
%bind     msg2      "Not Found! \n"

%bind     M             0x0F
%bind     ARR           res(M)
%bind     T             5

binarySearch:
    SETR    0           [P0] ; i
    SETR    M           [P1] ; j
%scope
    loop:
        PUSHR [P0]
        PUSHR [P1]
        GTI                 ; (i > j) ?
        JMPC loopEnd
    %scope
        getMidIdx:
            PUSH    val([P0])
            PUSH    val([P1])
            ADDI                            ; top = [P0]+[P1]
            PUSH    2
            DIVI                            ; top = ([P0]+[P1])/2

        getMidElem:
            DUPS    0
            PUSH    val([L0])
            ADDI                            ; top = &(arr[mid])
            READ1I                          ; read 1 byte int data
            SPOPR   [QT]

        isMidEqualToTarget:
        %scope
            PUSH    val([QT])
            PUSH    T
            EQI
            JMPC    found
        %end

        isMidLessOrGreaterThanTarget:
        %scope
            PUSH    val([QT])
            PUSH    T
            GEI
            JMPC    isGreater
            isLesser:
                PUSH    1
                ADDI                                ; top = mid + 1
                SPOPR   [P0]
                JMPU    loop
            isGreater:
                PUSH    1
                SUBI                                ; top = mid - 1
                SPOPR   [P1]
                JMPU    loop
        %end
    %end
    loopEnd:
    notFound:
        PUSH    0                                   ; return false
        SWAP    1
        RET

    found:
        SPOPR   [L2]
        PUSH    1                                   ; return true
        SWAP    1
        RET
%end

%entry main:
    SETR    msg0        [L0]
    SETR    len(msg0)   [QT]
    INVOK   7

%scope
    SETR     ARR  [L0] ; ptr to array
    SETR     M    [QT] ; len of arr

    PUSHR   [QT]
    PUSH    1
    SUBI                                ; top = [QT]-1

    ;; initialize array
    loop:
        DUPS    0                       ; i-1
        PUSHR   [L0]
        ADDI                            ; top = &(arr[i-1])
        DUPS    1
        WRITE1
        PUSH    1
        SUBI
        DUPS    0
        PUSH    0
        GEI
        JMPC    loop                    ; if (i >= 0)
    INVOK    dump_memory
    SPOP
    CALL    binarySearch
    JMPC    found

    notFound:
    %scope
        SETR    msg2        [L0]
        SETR    len(msg2)   [QT]
        INVOK   7
        JMPC    quit
    %end

    found:
    %scope
        SETR    msg1        [L0]
        SETR    len(msg1)   [QT]
        INVOK   7
        INVOK   print_i64
    %end
quit:
    SHUTS
%end
